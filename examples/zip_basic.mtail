# zip(): lockstep over parallel split() arrays (shortest wins).
# Sample line:
#   0.001,0.049 502,200 10.0.0.1:80,10.0.0.2:80

gauge upstream_rt by server
counter upstream_st by server

/(?P<rt>[^ ]+) (?P<st>[^ ]+) (?P<sv>[^ ]+)/ {
  $responses = split(",", $rt)
  $statuses = split(",", $st)
  $servers = split(",", $sv)
  zip($servers, $responses, $statuses) as ($server, $rtv, $stv) {
    upstream_rt[$server] = $rtv
    upstream_st[$server] = $stv
  }
}
